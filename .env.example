# Copy to .env and fill in. Everything works in DRY_RUN with none of these set.

# --- Cursor SDK (only needed for the live "money shot" run) ---
CURSOR_API_KEY=

# The GitHub repo the cloud agent clones and opens a PR against.
# Push THIS project to your own GitHub and point here.
GITHUB_REPO_URL=https://github.com/YOUR_USER/cursor-incident-agent

# true  = print the plan + agent prompts, open no PRs, spend no credits (default)
# false = actually start cloud agents (requires CURSOR_API_KEY + GITHUB_REPO_URL)
DRY_RUN=true

# Rehearsal aid (DRY_RUN only): replay a scripted agent stream so the demo UI
# drawer streams live and can be practiced without a key or credits. Off by
# default so the standard dry run stays deterministic.
SIMULATE_STREAM=false
# SIMULATE_STREAM_DELAY_MS=900   # pace of the rehearsal stream, in ms per event

# --- Ports (defaults are fine) ---
APP_PORT=3001
ORCHESTRATOR_PORT=3000

# --- Optional MCP tokens (see .cursor/mcp.json.example) ---
SENTRY_MCP_TOKEN=
SLACK_BOT_TOKEN=
